{
  "name": "source-rag-mcp",
  "version": "0.2.0",
  "description": "Local MCP server for indexing and searching Minecraft decompiled sources without redistributing game code.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "source-rag-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "prepack": "pnpm run typecheck && pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "minecraft",
    "decompiler",
    "rag",
    "codex"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.19.2",
    "tree-sitter": "^0.21.1",
    "tree-sitter-java": "^0.23.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
